            },
            "description": "Obtiene una alerta por ID"
          }
        },
        {
          "name": "DELETE /api/alertas/{id}",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{alertas_url}}/1",
              "host": ["{{alertas_url}}"],
              "path": ["1"]
            },
            "description": "Elimina una alerta por ID"
          }
        },
        {
          "name": "POST /api/alertas (Validation Error - campos vacíos)",
          "request": {
