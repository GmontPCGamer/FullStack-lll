            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Riesgo de Incendio en Sector Norte\",\n  \"mensaje\": \"Evacúe de inmediato el sector indicado.\",\n  \"nivelGravedad\": \"ALTO\"\n}"
            },
            "url": {
              "raw": "{{alertas_url}}",
              "host": ["{{alertas_url}}"]
