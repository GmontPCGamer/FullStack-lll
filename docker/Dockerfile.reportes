FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /app
COPY pom.xml ./
COPY businessdomain/pom.xml businessdomain/
COPY businessdomain/reportes-ms/pom.xml businessdomain/reportes-ms/
COPY infraestructuredomain/pom.xml infraestructuredomain/
RUN mvn dependency:go-offline -pl businessdomain/reportes-ms -am -B || true
COPY . .
RUN mvn package -pl businessdomain/reportes-ms -am -DskipTests -q

FROM eclipse-temurin:17-jre
COPY --from=builder /app/businessdomain/reportes-ms/target/*.jar app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/app.jar"]
