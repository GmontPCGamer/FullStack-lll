FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /app
COPY pom.xml ./
COPY businessdomain/pom.xml businessdomain/
COPY infraestructuredomain/pom.xml infraestructuredomain/
COPY infraestructuredomain/eurekaServer/pom.xml infraestructuredomain/eurekaServer/
RUN mvn dependency:go-offline -pl infraestructuredomain/eurekaServer -am -B || true
COPY . .
RUN mvn package -pl infraestructuredomain/eurekaServer -am -Dmaven.test.skip=true -q

FROM eclipse-temurin:17-jre
COPY --from=builder /app/infraestructuredomain/eurekaServer/target/*.jar app.jar
EXPOSE 8761
ENTRYPOINT ["java", "-jar", "/app.jar"]
