FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /app
COPY pom.xml ./
COPY businessdomain/pom.xml businessdomain/
COPY infraestructuredomain/pom.xml infraestructuredomain/
COPY infraestructuredomain/apigateway/pom.xml infraestructuredomain/apigateway/
RUN mvn dependency:go-offline -pl infraestructuredomain/apigateway -am -B || true
COPY . .
RUN mvn package -pl infraestructuredomain/apigateway -am -DskipTests -q

FROM eclipse-temurin:17-jre
COPY --from=builder /app/infraestructuredomain/apigateway/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app.jar"]
